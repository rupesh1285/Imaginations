generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ... (Keep your User model down here exactly as it is) ...

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique 
  email     String   @unique
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}